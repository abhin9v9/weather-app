{
  "name": "weather-dashboard",
  "version": "1.0.0",
  "description": "A full-stack weather dashboard application with React, Express, TypeScript, and MongoDB",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "clean": "rimraf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/weather-dashboard.git"
  },
  "keywords": [
    "weather",
    "dashboard",
    "react",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Abhinav Chaudhary",
  "license": "MIT"
}
